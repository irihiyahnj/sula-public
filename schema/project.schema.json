{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sula Project Manifest",
  "type": "object",
  "required": [
    "project",
    "repository",
    "rules",
    "stack",
    "paths",
    "commands",
    "deploy",
    "auth"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "slug", "description", "profile", "default_agent"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "default_agent": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["primary_branch", "working_branch_prefix", "deployment_branch"],
      "properties": {
        "primary_branch": {"type": "string"},
        "working_branch_prefix": {"type": "string"},
        "deployment_branch": {"type": "string"}
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "required": ["highest_rule", "custom_backend_allowed", "react_router_allowed"],
      "properties": {
        "highest_rule": {"type": "string"},
        "custom_backend_allowed": {"type": "boolean"},
        "react_router_allowed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "required": ["frontend", "backend"],
      "properties": {
        "frontend": {"type": "string"},
        "backend": {"type": "string"}
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "required": ["api_layer", "state_layer", "app_shell", "status_file", "change_records_file"],
      "properties": {
        "api_layer": {"type": "string"},
        "state_layer": {"type": "string"},
        "app_shell": {"type": "string"},
        "status_file": {"type": "string"},
        "change_records_file": {"type": "string"}
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "required": ["install", "dev", "build", "typecheck"],
      "properties": {
        "install": {"type": "string"},
        "dev": {"type": "string"},
        "build": {"type": "string"},
        "typecheck": {"type": "string"}
      },
      "additionalProperties": false
    },
    "deploy": {
      "type": "object",
      "required": ["base_path", "production_url", "workflow"],
      "properties": {
        "base_path": {"type": "string"},
        "production_url": {"type": "string"},
        "workflow": {"type": "string"}
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": ["session_expiry_codes", "permission_denied_codes"],
      "properties": {
        "session_expiry_codes": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "permission_denied_codes": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": [
        "change_record_directory",
        "release_record_directory",
        "incident_record_directory",
        "digest_file",
        "status_max_age_days"
      ],
      "properties": {
        "change_record_directory": {"type": "string", "minLength": 1},
        "release_record_directory": {"type": "string", "minLength": 1},
        "incident_record_directory": {"type": "string", "minLength": 1},
        "digest_file": {"type": "string", "minLength": 1},
        "status_max_age_days": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["pack", "stage", "artifacts_root"],
      "properties": {
        "pack": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "artifacts_root": {"type": "string", "minLength": 1},
        "docs_root": {"type": "string", "minLength": 1},
        "execution_mode": {"type": "string", "enum": ["solo-inline", "review-heavy", "subagent-parallel"]},
        "design_gate": {"type": "string", "enum": ["never", "complex-only", "always"]},
        "plan_gate": {"type": "string", "enum": ["never", "multi-step", "always"]},
        "review_policy": {"type": "string", "enum": ["none", "batch", "task-checkpoints", "strict"]},
        "workspace_isolation": {"type": "string", "enum": ["none", "branch", "worktree"]},
        "testing_policy": {"type": "string", "enum": ["inherit", "verify-first", "tdd"]},
        "closeout_policy": {"type": "string", "enum": ["inherit", "explicit"]}
      },
      "additionalProperties": false
    },
    "orchestration": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["ticket-runner", "review-assistant", "status-only"]},
        "task_source": {"type": "string", "enum": ["local", "provider-task-document", "provider-api"]},
        "runner": {"type": "string", "enum": ["dry-run", "codex-sdk", "codex-app-server", "shell-command"]},
        "runner_command": {"type": "string"},
        "runner_endpoint": {"type": "string"},
        "runner_token_env": {"type": "string"},
        "tasks_path": {"type": "string", "minLength": 1},
        "provider_task_item_id": {"type": "string"},
        "provider_task_item_kind": {"type": "string"},
        "provider_task_item_url": {"type": "string"},
        "workspace_root": {"type": "string", "minLength": 1},
        "workspace_mode": {"type": "string", "enum": ["none", "branch", "worktree", "copy", "container", "remote"]},
        "trust_profile": {"type": "string", "enum": ["local-sandboxed", "trusted-local", "remote-sandboxed"]},
        "allow_project_root_runner": {"type": "boolean"},
        "max_concurrent_runs": {"type": "integer", "minimum": 1},
        "max_retry_count": {"type": "integer", "minimum": 1},
        "max_run_minutes": {"type": "integer", "minimum": 1},
        "daily_budget_minutes": {"type": "integer", "minimum": 1},
        "unattended_risk_ceiling": {"type": "string", "enum": ["low", "medium", "high"]},
        "require_human_approval_for": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "status_surface": {"type": "string", "enum": ["sula", "external"]},
        "verification_adapters": {
          "type": "array",
          "items": {"type": "string", "enum": ["local-file", "artifact-catalog", "provider-metadata", "pull-request-url", "url"]}
        },
        "remote_verification_policy": {"type": "string", "enum": ["reference-only", "opportunistic", "required"]}
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["observe", "assist", "execute"]},
        "auto_intake": {"type": "boolean"},
        "auto_plan": {"type": "boolean"},
        "auto_dispatch": {"type": "boolean"},
        "risk_ceiling": {"type": "string", "enum": ["low", "medium", "high"]},
        "approval_required_for": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "event_sources": {
          "type": "array",
          "items": {"type": "string", "enum": ["sula-cli", "provider", "status", "artifact", "workflow", "external"]}
        }
      },
      "additionalProperties": false
    },
    "agent_behavior": {
      "type": "object",
      "required": ["quality_policy"],
      "properties": {
        "quality_policy": {"type": "string", "enum": ["sula-karpathy-inspired", "minimal"]},
        "clarification_policy": {"type": "string", "enum": ["non-trivial-only", "always", "never"]},
        "diff_scope_policy": {"type": "string", "enum": ["surgical", "task-scoped", "open"]},
        "success_criteria_policy": {"type": "string", "enum": ["required", "recommended", "off"]},
        "assumption_policy": {"type": "string", "enum": ["surface-when-uncertain", "always", "off"]},
        "complexity_policy": {"type": "string", "enum": ["simplicity-first", "project-default"]},
        "require_verification": {"type": "boolean"},
        "forbid_drive_by_refactors": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["provider", "sync_mode", "workspace_root", "provider_root_url", "provider_root_id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "sync_mode": {"type": "string", "minLength": 1},
        "workspace_root": {"type": "string", "minLength": 1},
        "provider_root_url": {"type": "string", "minLength": 1},
        "provider_root_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "portfolio": {
      "type": "object",
      "required": ["portfolio_id", "workspace", "owner"],
      "properties": {
        "portfolio_id": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "language": {
      "type": "object",
      "required": ["content_locale", "interaction_locale", "preserve_user_input_language"],
      "properties": {
        "content_locale": {"type": "string", "minLength": 1},
        "interaction_locale": {"type": "string", "minLength": 1},
        "preserve_user_input_language": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "required": ["mode", "enabled_packs"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["detached", "collaborative", "governed"]
        },
        "enabled_packs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "project-memory",
              "record-templates",
              "document-design",
              "ops-core",
              "profile-architecture",
              "profile-runbooks",
              "ai-tooling"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "document_design": {
      "type": "object",
      "required": [
        "principles_path",
        "source_first",
        "register_derived_artifacts",
        "preferred_source_format",
        "schedule_bundle",
        "proposal_bundle",
        "report_bundle",
        "process_bundle",
        "training_bundle"
      ],
      "properties": {
        "principles_path": {"type": "string", "minLength": 1},
        "source_first": {"type": "boolean"},
        "register_derived_artifacts": {"type": "boolean"},
        "preferred_source_format": {"type": "string", "minLength": 1},
        "schedule_bundle": {"type": "string", "minLength": 1},
        "proposal_bundle": {"type": "string", "minLength": 1},
        "report_bundle": {"type": "string", "minLength": 1},
        "process_bundle": {"type": "string", "minLength": 1},
        "training_bundle": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
